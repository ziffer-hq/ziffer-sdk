{
  "name": "@ziffer-io/scan",
  "version": "0.3.0",
  "description": "Scan the AI agents on this machine, replay an injected proposal against a generated agent authorization policy, nothing leaves the machine.",
  "keywords": [
    "ziffer",
    "ai-agent",
    "mcp",
    "scan",
    "agent-authorization"
  ],
  "author": "code75 SASU",
  "license": "FSL-1.1-ALv2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "ziffer-scan": "./dist/bin.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "data",
    "assets",
    "py",
    "!py/__pycache__/**",
    "!dist/**/*.test.*",
    "!dist/**/fixtures/**",
    "THIRD-PARTY-NOTICES",
    "THIRD-PARTY-NOTICES.attribution.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziffer-hq/ziffer-sdk.git",
    "directory": "packages/scan"
  },
  "homepage": "https://ziffer.io",
  "publishConfig": {
    "access": "public"
  },
  "ziffer": {
    "enginePin": "0ce0567bec3ee9d8c2b58d8c26c1ec83c4782f72"
  },
  "scripts": {
    "embed": "node scripts/embed.mjs",
    "vendor": "node scripts/vendor-wasm.mjs",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "build": "pnpm run embed && pnpm run vendor && tsc -b",
    "typecheck": "pnpm run embed && tsc -b",
    "pretest": "pnpm --filter \"@ziffer-io/client...\" run build && pnpm run embed && tsc -b && node scripts/check-tests-built.mjs",
    "test": "pnpm run embed && tsc -b && node ../types/scripts/run-tests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@google/genai": "2.24.0",
    "@langchain/core": "1.2.12",
    "@mistralai/mistralai": "2.7.0",
    "@noble/curves": "2.3.0",
    "@noble/post-quantum": "0.7.0",
    "@types/node": "^22.15.0",
    "@ziffer-io/client": "workspace:*",
    "@ziffer-io/verify": "workspace:*",
    "ai": "7.0.116",
    "cohere-ai": "8.1.0",
    "openai": "7.23.0",
    "zod": "4.6.5"
  }
}
